{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Tuftu Visuals PvP",
	"description": "PvP Visuals, Sword ViewModel, Pearl Bind & ClickGUI (Right Shift)",
	"authors": [
		"Tuftu"
	],
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}
}
